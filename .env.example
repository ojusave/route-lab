# Server-side only. Never prefix these with VITE_.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
# Optional dialogue model. Voting always uses TypeSafe.
# OPENROUTER_MODEL=openai/gpt-4.1-mini

# The local launcher sets these separately for each backend.
# For a cloud workflow, remove RENDER_LOCAL_DEV_URL and set:
# RENDER_API_KEY=
# RENDER_WORKFLOW_SLUG=

# Public URL only. Also set by npm run configure:repo -- <github-url>.
VITE_REPOSITORY_URL=
